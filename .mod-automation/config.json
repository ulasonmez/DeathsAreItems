  "branch_policy": "current_branch",
  "antigravity_timeout": "90m",
  "default_execution_profile": "MEDIUM",
  "checkpoint_execution_profile": "LOW",
  "execution_profiles": {
    "LOW": {
      "model": null,
      "effort": "low",
      "timeout": "45m"
    },
    "MEDIUM": {
      "model": null,
      "effort": "medium",
      "timeout": "90m"
    },
    "HIGH": {
      "model": null,
      "effort": "high",
      "timeout": "120m"
    }
  },
  "project_state_warning_bytes": 15360,
  "project_state_strong_warning_bytes": 25600
}